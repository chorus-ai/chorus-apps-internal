# ---- Runtime ----
NODE_ENV=development           # development | test | production | chorus_dev | chorus_prod
PORT=8080
APP_HOST=
APP_NAME=CHoRUS
APP_VERSION=1.0.0

# ---- Auth ----
JWT_SECRET=change-me

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=

# ---- Feature toggle ----
# Comma-separated allowlist. Unset/empty = ALL features load.
# Available: omop,vocab,form,assets,cada,ive,m2d,cbw,crc,diet,pair,post,survey,alarmx
FEATURES=

# ---- App DB (PostgreSQL — used when NODE_ENV=production/chorus_*) ----
# In development/test, SQLite files under server/data/ are used; these are ignored.
DB_HOSTNAME=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# ---- MongoDB (optional — loaded only if set) ----
MONGO_HOST=

# ---- Storage ----
BUCKET_PATH=

# ---- AWS S3 ----
# Convention: if AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are missing or empty,
# we assume we're on a production VM and the SDK pulls creds from the instance
# role (EC2/ECS IMDS). Only fill these in for LOCAL dev.
# AWS_SESSION_TOKEN is required when using temporary/STS keys; leave blank for long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ---- Misc ----
PYTHON_PATH=
